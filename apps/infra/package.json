{
	"name": "@astro-aws/infra",
	"version": "0.0.0",
	"private": true,
	"homepage": "https://www.astro-aws.org/",
	"repository": {
		"type": "git",
		"url": "ssh://git@github.com/lukeshay/astro-aws.git",
		"directory": "apps/infra"
	},
	"license": "MIT",
	"type": "module",
	"bin": {
		"astro-aws-cdk": "dist/bin/infra.js"
	},
	"files": [
		"dist",
		"cdk.out"
	],
	"scripts": {
